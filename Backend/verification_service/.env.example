# Copia este archivo a .env y rellena los valores.

# URL de tu proyecto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=https://ddygpqkuxgfrjdipdvek.supabase.co

# ⚠️ SERVICE ROLE KEY (Project Settings → API → service_role secret)
# NO la pongas en la app Flutter — solo aquí, en el servidor.
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_tu_service_role_key

# Bucket privado con las imágenes de verificación
VERIFICATION_BUCKET=verification-docs

# Umbral de aprobación automática (similitud 0..1). 0.50 = 50%.
# Si el match es MAYOR a este valor -> aprobado automático.
# Cualquier valor igual o menor -> revisión manual del equipo Baratito.
APPROVE_THRESHOLD=0.50

# Modelo / métrica de DeepFace
DEEPFACE_MODEL=Facenet512
DEEPFACE_METRIC=cosine

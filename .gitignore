# Ignore Frontend build directories globally
Frontend/build/
Frontend/.dart_tool/
Frontend/android/local.properties
.DS_Store

# Node — el proyecto no usa Node; evitar re-commitear basura
node_modules/
package-lock.json

# Secretos del servicio de verificación (service_role key) — NUNCA subir
Backend/verification_service/.env
__pycache__/

# Llave privada de la cuenta de servicio de Firebase — NUNCA subir
# (google-services.json SÍ es commiteable; este otro NO)
*firebase-adminsdk*.json
service-account*.json

# Temporales del CLI de Supabase
supabase/.temp/

# Caché de Vite de la landing (se regenera sola, no debe subirse)
frontend_web/.vite/
